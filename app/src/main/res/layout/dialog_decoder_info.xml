<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_bg_main"
        android:padding="@dimen/vs_30">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/vs_20"
            android:text="@string/about_decoder_title"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <!-- 解码器数量统计 -->
        <TextView
            android:id="@+id/tv_decoder_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_22" />

        <!-- 列表区域，使用固定高度或weight控制 -->
        <!-- 去掉默认橘黄选中色,更改为与主题统一 -->
        <ListView
            android:id="@+id/lv_decoder_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:listSelector="@drawable/button_dialog_vod"
        />

        <!-- 操作按钮，风格与免责声明的“同意”按钮一致 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/vs_20"
            android:background="@drawable/button_dialog_main"
            android:padding="@dimen/vs_10"
            android:text="@string/about_save_decoding_info"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_22" />

    </LinearLayout>
</FrameLayout>